GROQ_API_KEY=your_key_here

QDRANT_API_KEY=your_key_here
QDRANT_URL=https://xxxx-xxxx-xxxx.region-0.aws.cloud.qdrant.io

INTENT_LLM_MODEL="groq/llama-3.3-70b-versatile"
GENERATION_LLM_MODEL="groq/openai/gpt-oss-120b"

RETRIEVAL_TOP_K=3
EMBED_MODEL="all-MiniLM-L6-v2"

LOG_LEVEL=INFO
ALLOWED_ORIGINS=["*"]

# OpenTelemetry monitoring (used with deployment.main_otel:app or deployment.main:app)
OTEL_ENABLED=true
AXIOM_TOKEN=your_axiom_api_token
OTEL_SERVICE_NAME=serenity-mental-health-api
OTEL_SERVICE_VERSION=0.1.0
OTEL_DEPLOYMENT_ENVIRONMENT=development
